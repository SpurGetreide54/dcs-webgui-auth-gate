# auth-gate (src/server.js)
PORT=3000
SQLITE_PATH=./data/auth-gate.sqlite
MISSION_AGENT_URL=http://10.0.1.10:4000
MISSION_AGENT_TOKEN=change-me-to-a-long-random-value
MAX_MISSION_BYTES=209715200
# Set to "false" only for local http-only development; the real deployment
# behind the reverse proxy must keep this true so the session cookie is
# marked Secure.
COOKIE_SECURE=true

# mission-agent (src/agent.js) — set these on the physical host instead
# AGENT_PORT=4000
# MISSION_AGENT_TOKEN=change-me-to-a-long-random-value
# MISSION_FOLDER_TRAINING=C:\path\to\Training\Missions
# MISSION_FOLDER_COMMUNITY1=C:\path\to\Community1\Missions
# MISSION_FOLDER_COMMUNITY2=C:\path\to\Community2\Missions
