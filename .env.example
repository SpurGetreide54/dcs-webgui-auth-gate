# section: auth-gate (src/server.js)
PORT=3000
MISSION_AGENT_URL=http://10.0.1.10:4000
# must match the mission-agent's own MISSION_AGENT_TOKEN, see
# docs/Installation.md for how to read it from agent-token.txt
MISSION_AGENT_TOKEN=change-me-to-a-long-random-value
MAX_MISSION_BYTES=209715200
#
# set to "false" only for local http-only development, the real
# deployment must keep this true so the session cookie is marked secure
COOKIE_SECURE=true
#
# required in production, see docs/A-B-Self-Update.md. derives
# webgui-static/, active-slot, auth-gate.log, and auth-gate.sqlite as
# fixed sub-paths of this one directory
# AUTH_GATE_STATE_DIR=/var/www/dcs-webgui-auth-gate
#
# optional overrides below, each already has a working default
#
# the shared control-port proxy's own listen port, must match
# dcs-webgui-reverse-proxy's dcs-panel.conf
# WEBGUI_CONTROL_PORT=8088
#
# name shown in the navbar, default is "DCS Auth Gate"
# BRAND_NAME=Your Community Name
#
# deprecated, still work: each overrides its one path individually,
# taking priority over AUTH_GATE_STATE_DIR above. new deployments
# should set AUTH_GATE_STATE_DIR instead. see docs/Configuration.md
# SQLITE_PATH=/var/www/dcs-webgui-auth-gate/auth-gate.sqlite
# WEBGUI_STATIC_PATH=/var/www/dcs-webgui-auth-gate/webgui-static
# ACTIVE_SLOT_PATH=/var/www/dcs-webgui-auth-gate/active-slot
# AUTH_GATE_LOG_PATH=/var/www/dcs-webgui-auth-gate/auth-gate.log
#
# mission-agent (src/agent.js) runs elsewhere and never reads this
# file, see docs/Configuration.md for its own variables
