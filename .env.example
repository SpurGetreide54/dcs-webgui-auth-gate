# ---- auth-gate (src/server.js) ----
PORT=3000
SQLITE_PATH=./data/auth-gate.sqlite
MISSION_AGENT_URL=http://10.0.1.10:4000
# Must match the mission-agent's own MISSION_AGENT_TOKEN. In production,
# the agent generates this value itself and saves it to agent-token.txt —
# read that file and paste its contents here. In local development, pick
# any value and pass the same one to `npm run agent`. See docs/SETUP.md.
MISSION_AGENT_TOKEN=change-me-to-a-long-random-value
MAX_MISSION_BYTES=209715200
#
# Set to "false" only for local http-only development. The real deployment
# behind the reverse proxy must keep this true so the session cookie is
# marked Secure.
COOKIE_SECURE=true
#
# Optional overrides below. Each already has a working default. Uncomment
# and set only the ones you want to change.
#
# Port the shared control-port proxy (serverProxy.js) listens on. Must match
# whatever the reverse proxy forwards to on the public side, and the browser
# dials this exact port directly (see dcs-webgui-reverse-proxy's dcs-panel.conf).
# WEBGUI_CONTROL_PORT=8088
#
# Only needed if webgui-static/ should live somewhere other than the
# repo-relative default (e.g. a different volume/mount).
# WEBGUI_STATIC_PATH=/srv/dcs-webgui-static
#
# Name shown in the navbar. Default is "DCS Auth Gate".
# BRAND_NAME=Your Community Name
#
# mission-agent (src/agent.js) runs on a different machine and never reads
# this file. See docs/SETUP.md for its variables.
