# reference copy of the production unit, diff against the live one
# with "systemctl cat dcs-webgui-auth-gate", see docs/A-B-Self-Update.md
# for the full apply procedure, and docs/Why.md#why-does-applyupdate-exit0-instead-of-exit1
# for why ExecStart runs launcher.js and Restart=always, not on-failure

[Unit]
Description=dcs-webgui-auth-gate
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3
OnFailure=dcs-webgui-auth-gate-rollback.service

[Service]
Type=simple
User=dcs-webgui-auth-gate
Group=dcs-webgui-auth-gate
WorkingDirectory=/var/www/dcs-webgui-auth-gate
EnvironmentFile=/var/www/dcs-webgui-auth-gate/.env
ExecStart=/usr/bin/node launcher.js
Restart=always
RestartSec=5
# catches a native crash (segfault, V8 fatal error) that never reaches
# uncaughtException, no JS runs to log it, only an OS-level redirect can
# see docs/Why.md#why-does-the-service-unit-redirect-stdout-stderr-to-the-app-log
StandardOutput=append:/var/www/dcs-webgui-auth-gate/auth-gate.log
StandardError=append:/var/www/dcs-webgui-auth-gate/auth-gate.log

[Install]
WantedBy=multi-user.target
