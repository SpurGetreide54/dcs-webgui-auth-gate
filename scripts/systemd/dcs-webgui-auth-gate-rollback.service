# runs once, as root, whenever the real unit's OnFailure= fires
# flips active-slot and restarts into the slot that was working before
# see docs/Why.md#why-is-the-rollback-a-separate-systemd-unit
#
# Install alongside the real unit at
# /etc/systemd/system/dcs-webgui-auth-gate-rollback.service, then
# systemctl daemon-reload. See docs/A-B-Self-Update.md.

[Unit]
Description=Roll dcs-webgui-auth-gate back to its other A/B slot after repeated start failures

[Service]
Type=oneshot
# the actual logic lives in the sibling .sh file, not inline here
# see docs/Why.md#why-is-the-rollback-logic-a-separate-sh-file-not-inline-in-execstart
ExecStart=/bin/sh /var/www/dcs-webgui-auth-gate/scripts/systemd/dcs-webgui-auth-gate-rollback.sh
